      <container n="Robin_condition_coefficients" pn="Robin condition coefficients">
        <blockdata n='material' name='Robin_coefficients_Plane_waves' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Robin_coeffs_Plane_waves" state="hidden">
          </value>
          <value n="Multiple_waves" pn="Multiple waves" v="Off" values="On,Off" help="Enables the application of multiple plane waves on a boundary.\nAll the plane waves with &quot;Multiple_waves = On&quot; will be added \ncoherently to the same boundary, using the material properties \ndefined for the first plane wave.">
          </value>
          <value n="Module_E_field" pn="Module E field" v="0.0" help="Module of the electric field.">
          </value>
          <value n="Phase_E_field" pn="Phase E field" v="0.0" help="Phase of the electric field.">
          </value>
          <value n="Polarization_X" pn="Polarization X" v="0.0" help="X component of the polarization vector.">
          </value>
          <value n="Polarization_Y" pn="Polarization Y" v="0.0" help="Y component of the polarization vector.">
          </value>
          <value n="Polarization_Z" pn="Polarization Z" v="0.0" help="Z component of the polarization vector.">
          </value>
          <value n="Wave_vector_X" pn="Wave vector X" v="0.0" help="X component of the wave vector.">
          </value>
          <value n="Wave_vector_Y" pn="Wave vector Y" v="0.0" help="Y component of the wave vector.">
          </value>
          <value n="Wave_vector_Z" pn="Wave vector Z" v="0.0" help="Z component of the wave vector.">
          </value>
          <value n="IBC_conductivity_real" pn="IBC conductivity real" v="0.0" help="Real part of the electric conductivity (S/m) for the impedance boundary condition.">
          </value>
          <value n="IBC_conductivity_img" pn="IBC conductivity img" v="0.0" help="Imaginary part of the electric conductivity (S/m) for the impedance boundary condition.">
          </value>
          <value n="IBC_permittivity_real" pn="IBC permittivity real" v="1.0" help="Real part of the relative electric permittivity for the impedance boundary condition.">
          </value>
          <value n="IBC_permittivity_img" pn="IBC permittivity img" v="0.0" help="Imaginary part of the relative electric permittivity for the impedance boundary condition.">
          </value>
          <value n="IBC_permeability_real" pn="IBC permeability real" v="1.0" help="Real part of the relative magnetic permeability for the impedance boundary condition.">
          </value>
          <value n="IBC_permeability_img" pn="IBC permeability img" v="0.0" help="Imaginary part of the relative magnetic permeability for the impedance boundary condition.">
          </value>
        </blockdata>
        <blockdata n='material' name='Robin_coefficients_Gauss_beam' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Robin_coeffs_Gauss_beam" state="hidden">
          </value>
          <value n="GB_module_E_par" pn="GB module E par" v="0.0" help="Module of the electric field parallel to the polarization vector at the waist centre.">
          </value>
          <value n="GB_phase_E_par" pn="GB phase E par" v="0.0" help="Phase of the electric field parallel to the polarization vector at the waist centre.">
          </value>
          <value n="GB_module_E_per" pn="GB module E per" v="0.0" help="Module of the electric field perpendicular to the polarization and wave vectors at the waist centre.">
          </value>
          <value n="GB_phase_E_per" pn="GB phase E per" v="0.0" help="Phase of the electric field perpendicular to the polarization and wave vectors at the waist centre.">
          </value>
          <value n="GB_radius_par" pn="GB radius par" v="0.0" help="Gaussian beam waist radius in the direction parallel to the polarization vector. ">
          </value>
          <value n="GB_radius_per" pn="GB radius per" v="0.0" help="Gaussian beam waist radius in the direction perpendicular to the polarization and wave vectors.">
          </value>
          <value n="GB_00_X" pn="GB 00 X" v="0.0" help="X coordinate of the centre of the Gaussian beam waist.">
          </value>
          <value n="GB_00_Y" pn="GB 00 Y" v="0.0" help="Y coordinate of the centre of the Gaussian beam waist.">
          </value>
          <value n="GB_00_Z" pn="GB 00 Z" v="0.0" help="Z coordinate of the centre of the Gaussian beam waist.">
          </value>
          <value n="GB_polarization_X" pn="GB polarization X" v="0.0" help="X component of the polarization vector.">
          </value>
          <value n="GB_polarization_Y" pn="GB polarization Y" v="0.0" help="Y component of the polarization vector.">
          </value>
          <value n="GB_polarization_Z" pn="GB polarization Z" v="0.0" help="Z component of the polarization vector.">
          </value>
          <value n="GB_wave_vector_X" pn="GB wave vector X" v="0.0" help="X component of the wave vector.">
          </value>
          <value n="GB_wave_vector_Y" pn="GB wave vector Y" v="0.0" help="Y component of the wave vector.">
          </value>
          <value n="GB_wave_vector_Z" pn="GB wave vector Z" v="0.0" help="Z component of the wave vector.">
          </value>
        </blockdata>
        <blockdata n='material' name='Robin_coefficients_Quasiestatic' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Robin_coeffs_Quasiestatic" state="hidden">
          </value>
          <value n="Robin_coeff_real" pn="Robin coeff real" v="0.0" help="Real part of the Robin boundary condition coefficient.">
          </value>
          <value n="Robin_coeff_img" pn="Robin coeff img" v="0.0" help="Imaginary part of the Robin boundary condition coefficient.">
          </value>
          <value n="Module_Flux" pn="Module Flux" v="0.0" help="Module of the injected current density.\nOnly defined for A-phi potentials formulations.">
          </value>
          <value n="Phase_Flux" pn="Phase Flux" v="0.0" help="Phase of the injected current density.\nOnly defined for A-phi potentials formulations.">
          </value>
        </blockdata>
        <blockdata n='material' name='Robin_coefficients_Electrostatic' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Robin_coeffs_Electrostatic" state="hidden">
          </value>
          <value n="Robin_coeff" pn="Robin coeff" v="0.0" help="Robin boundary condition coefficient.\nOnly defined for the &apos;Electrostatic&apos; mode.">
          </value>
          <value n="Flux" pn="Flux" v="0.0" help="Robin boundary condition flux.\nOnly defined for the &apos;Electrostatic&apos; mode.">
          </value>
        </blockdata>
      </container>
      <container n="Plasma_far_field_propeties" pn="Plasma far field propeties" help="Plasma far field properties">
        <blockdata n='material' name='FW' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Plasma_wave_type">
          </value>
          <value n="Plasma_Wave_Type_ID" pn="Plasma Wave Type ID" v="1.0" help="Cold plasma wave type at the boundary FW ( n2 = RL/S ).">
          </value>
        </blockdata>
        <blockdata n='material' name='RW' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Plasma_wave_type">
          </value>
          <value n="Plasma_Wave_Type_ID" pn="Plasma Wave Type ID" v="2.0" help="Cold plasma wave type at the boundary RW ( n2 = R ).">
          </value>
        </blockdata>
        <blockdata n='material' name='LW' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Plasma_wave_type">
          </value>
          <value n="Plasma_Wave_Type_ID" pn="Plasma Wave Type ID" v="3.0" help="Cold plasma wave type at the boundary LW ( n2 = L ).">
          </value>
        </blockdata>
        <blockdata n='material' name='PW' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="Plasma_wave_type">
          </value>
          <value n="Plasma_Wave_Type_ID" pn="Plasma Wave Type ID" v="4.0" help="Cold plasma wave type at the boundary PW ( n2 = P ).">
          </value>
        </blockdata>
      </container>
      <container n="Current_sources_properties" pn="Current sources properties" help="Current sources properties">
        <blockdata n='material' name='J_cartesian' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="FDJcartesian" state="hidden">
          </value>
          <value n="Jx" pn="Jx" v="0.0" help="Modulus of the X component of the electric current density vector (A/m^2).">
          </value>
          <value n="Phx" pn="Phx" v="0.0" help="Phase of the X component of the electric current density vector (rad).">
          </value>
          <value n="Jy" pn="Jy" v="0.0" help="Modulus of the Y component of the electric current density vector (A/m^2).">
          </value>
          <value n="Phy" pn="Phy" v="0.0" help="Phase of the Y component of the electric current density vector (rad).">
          </value>
          <value n="Jz" pn="Jz" v="0.0" help="Modulus of the Z component of the electric current density vector (A/m^2).">
          </value>
          <value n="Phz" pn="Phz" v="0.0" help="Phase of the Z component of the electric current density vector (rad).">
          </value>
        </blockdata>
        <blockdata n='material' name='J_axisymm' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="FDJaxisymm" state="hidden">
          </value>
          <value n="Ja" pn="Ja" v="0.0" help="Modulus of the angular component of the axisymmetric electric current density vector (A/m^2).\nThe current density is axisymmetric with respect to the axis AX_axis_XYZ with centre of curvature on AX_00_XYZ.">
          </value>
          <value n="Pha" pn="Pha" v="0.0" help="Phase of the angular component of the axisymmetric electric current density vector (rad).\nThe current density is axisymmetric with respect to the axis AX_axis_XYZ with centre of curvature on AX_00_XYZ.">
          </value>
          <value n="AX_00_X" pn="AX 00 X" v="0.0" help="X coordinate of the centre of curvature. ">
          </value>
          <value n="AX_00_Y" pn="AX 00 Y" v="0.0" help="Y coordinate of the centre of curvature. ">
          </value>
          <value n="AX_00_Z" pn="AX 00 Z" v="0.0" help="Z coordinate of the centre of curvature.  ">
          </value>
          <value n="AX_axis_X" pn="AX axis X" v="0.0" help="X component of the axisymmetric axis.">
          </value>
          <value n="AX_axis_Y" pn="AX axis Y" v="0.0" help="Y component of the axisymmetric axis.">
          </value>
          <value n="AX_axis_Z" pn="AX axis Z" v="0.0" help="Z component of the axisymmetric axis.">
          </value>
        </blockdata>
        <blockdata n='material' name='J_combine' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <container n="Cartesian" pn="Cartesian">
            <value n="property" pn="property" v="FDJcombine" state="hidden">
            </value>
            <value n="Jx" pn="Jx" v="0.0" help="Modulus of the X component of the electric current density vector (A/m^2).">
            </value>
            <value n="Phx" pn="Phx" v="0.0" help="Phase of the X component of the electric current density vector (rad).">
            </value>
            <value n="Jy" pn="Jy" v="0.0" help="Modulus of the Y component of the electric current density vector (A/m^2).">
            </value>
            <value n="Phy" pn="Phy" v="0.0" help="Phase of the Y component of the electric current density vector (rad).">
            </value>
            <value n="Jz" pn="Jz" v="0.0" help="Modulus of the Z component of the electric current density vector (A/m^2).">
            </value>
            <value n="Phz" pn="Phz" v="0.0" help="Phase of the Z component of the electric current density vector (rad).">
            </value>
          </container>
          <container n="Axisymmetric" pn="Axisymmetric">
            <value n="Ja" pn="Ja" v="0.0" help="Modulus of the angular component of the axisymmetric electric current density vector (A/m^2).\nThe current density is axisymmetric with respect to the axis AX_axis_XYZ with centre of curvature on AX_00_XYZ.">
            </value>
            <value n="Pha" pn="Pha" v="0.0" help="Phase of the angular component of the axisymmetric electric current density vector (rad).\nThe current density is axisymmetric with respect to the axis AX_axis_XYZ with centre of curvature on AX_00_XYZ.">
            </value>
            <value n="AX_00_X" pn="AX 00 X" v="0.0" help="X coordinate of the centre of curvature. ">
            </value>
            <value n="AX_00_Y" pn="AX 00 Y" v="0.0" help="Y coordinate of the centre of curvature. ">
            </value>
            <value n="AX_00_Z" pn="AX 00 Z" v="0.0" help="Z coordinate of the centre of curvature. ">
            </value>
            <value n="AX_axis_X" pn="AX axis X" v="0.0" help="X component of the axisymmetric axis.">
            </value>
            <value n="AX_axis_Y" pn="AX axis Y" v="0.0" help="Y component of the axisymmetric axis.">
            </value>
            <value n="AX_axis_Z" pn="AX axis Z" v="0.0" help="Z component of the axisymmetric axis.">
            </value>
          </container>
        </blockdata>
        <blockdata n='material' name='J_helicoidal' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="FDJhelicoidal" state="hidden">
          </value>
          <value n="Jpol" pn="Jpol" v="0.0" help="Module of the poloidal component of the helicoidal current density (A/m^2).">
          </value>
          <value n="Php" pn="Php" v="0.0" help="Phase of the poloidal component of the helicoidal current density (rad).">
          </value>
          <value n="Jtor" pn="Jtor" v="0.0" help="Module of the toroidal component of the helicoidal current density (A/m^2).">
          </value>
          <value n="Pht" pn="Pht" v="0.0" help="Phase of the toroidal component of the helicoidal current density (rad).">
          </value>
          <value n="HL_R" pn="HL R" v="0.0" help="Major radius of the torus in where the helicoidal current is applied.\nMust be greater than zero.">
          </value>
          <value n="HL_00_X" pn="HL 00 X" v="0.0" help="X coordinate of the torus centre.">
          </value>
          <value n="HL_00_Y" pn="HL 00 Y" v="0.0" help="Y coordinate of the torus centre.">
          </value>
          <value n="HL_00_Z" pn="HL 00 Z" v="0.0" help="Z coordinate of the torus centre.">
          </value>
          <value n="HL_axis_X" pn="HL axis X" v="0.0" help="X component of the torus axis.">
          </value>
          <value n="HL_axis_Y" pn="HL axis Y" v="0.0" help="Y component of the torus axis.">
          </value>
          <value n="HL_axis_Z" pn="HL axis Z" v="0.0" help="Z component of the torus axis.">
          </value>
        </blockdata>
        <blockdata n='material' name='J_plasmam' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="property" pn="property" v="FDJplasmam" state="hidden">
          </value>
          <value n="Jpol" pn="Jpol" v="0.0" help="Module of the complex constant applied to the poloidal current density component (A/m^2).">
          </value>
          <value n="Php" pn="Php" v="0.0" help="Phase of the complex constant applied to the poloidal current density component (rad).">
          </value>
          <value n="Jtor" pn="Jtor" v="0.0" help="Module of the complex constant applied to the toroidal current density component (A/m^2).">
          </value>
          <value n="Pht" pn="Pht" v="0.0" help="Phase of the complex constant applied to the toroidal current density component (rad).">
          </value>
          <value n="PM_M" pn="PM M" v="0" help="Plasma mode index ( M ):\n- Jpol = |Jpol| * exp( i*Php ) * sin( M * Theta + Phi ).\n- Jtor  = |Jtor| * exp( i*Pht  ) * { - M * [ ( R / r ) + cos( Theta ) ] * sin( M * Theta + Phi ) - sin( Theta ) * cos( M * Theta + Phi ) }.">
          </value>
          <value n="PM_R" pn="PM R" v="0.0" help="Major radius of the torus in where the plasma mode is applied.\nMust be greater than cero.">
          </value>
          <value n="PM_00_X" pn="PM 00 X" v="0.0" help="X coordinate of the torus centre.">
          </value>
          <value n="PM_00_Y" pn="PM 00 Y" v="0.0" help="Y coordinate of the torus centre.">
          </value>
          <value n="PM_00_Z" pn="PM 00 Z" v="0.0" help="Z coordinate of the torus centre.">
          </value>
          <value n="PM_axis_X" pn="PM axis X" v="0.0" help="X component of the torus axis.">
          </value>
          <value n="PM_axis_Y" pn="PM axis Y" v="0.0" help="Y component of the torus axis.">
          </value>
          <value n="PM_axis_Z" pn="PM axis Z" v="0.0" help="Z component of the torus axis.">
          </value>
        </blockdata>
      </container>
      <container n="Volume_to_integer_propeties" pn="Volume to integer propeties" help="Volume to integer propeties">
        <blockdata n='material' name='Volume_to_integer_1' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="Volume_ID" pn="Volume ID" v="1.0">
          </value>
        </blockdata>
      </container>
      <container n="Surface_to_integer_propeties" pn="Surface to integer propeties" help="Surface to integer propeties">
        <blockdata n='material' name='Surface_to_integer_1' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="Surface_ID" pn="Surface ID" v="1.0">
          </value>
        </blockdata>
      </container>
      <container n="Imported_Robin_surfaces" pn="Imported Robin surfaces" help="Imported Robin surfaces">
        <blockdata n='material' name='IRBCS_to_integer_1' sequence='1' editable_name='unique' icon='material16' help='Material definition' morebutton='0'>
          <value n="IRBCS_ID" pn="IRBCS ID" v="1.0">
          </value>
        </blockdata>
      </container>
    </container>
    <condition n="bodies" pn="Bodies" ov="volume" ovm="element" icon="darkorange-group" help="Assign materials to volumes.">
      <value n="material" pn="Material" v="" values="[::Ermes::GetMaterialList]" help="Select material from list"/>
    </condition>
  </container>

  <container n="Conditions" pn="Conditions">
    <container n="Dirichlet_conditions" pn="Dirichlet conditions">
      <condition n="Point_Voltage_Full_wave" pn="Point Voltage Full wave" ov="point" ovm="node" icon="drag" help="Time-harmonic voltage module over points.">
        <value n="Module_Voltage" pn="Module Voltage" v="0.0" help="Time-harmonic voltage module over points.">
        </value>
        <value n="Phase_Voltage" pn="Phase Voltage" v="0.0" help="Time-harmonic voltage phase over points.">
        </value>
      </condition>
      <condition n="Point_Voltage_Electrostatic" pn="Point Voltage Electrostatic" ov="point" ovm="node" icon="drag" help="Electrostatic voltage over points.">
        <value n="Voltage" pn="Voltage" v="0.0" help="Electrostatic voltage over points.">
        </value>
      </condition>
      <condition n="Point_Singularity" pn="Point Singularity" ov="point" ovm="node" icon="drag" help="Number of ungaged layers around a point:\n- In the regularized formulations, the divergence term of the elements\n   inside the ungauged layers is removed.\n- In the LL2P formulations, both the divergence term and the bubble\n   contribution of the elements inside the ungauged layers are removed.">
        <value n="Ungaged_layers" pn="Ungaged layers" v="1" values="1,2,3,4,5,6" help="Number of ungaged layers around a point:\n- In the regularized formulations, the divergence term of the elements\n   inside the ungauged layers is removed.\n- In the LL2P formulations, both the divergence term and the bubble\n   contribution of the elements inside the ungauged layers are removed.">
        </value>
      </condition>
      <condition n="Line_Voltage_Full_wave" pn="Line Voltage Full wave" ov="line" ovm="node" icon="drag" help="Time-harmonic voltage module over lines.">
        <value n="Module_Voltage" pn="Module Voltage" v="0.0" help="Time-harmonic voltage module over lines.">
        </value>
        <value n="Phase_Voltage" pn="Phase Voltage" v="0.0" help="Time-harmonic voltage phase over lines.">
        </value>
      </condition>
      <condition n="Line_Voltage_Electrostatic" pn="Line Voltage Electrostatic" ov="line" ovm="node" icon="drag" help="Electrostatic voltage over lines.">
        <value n="Voltage" pn="Voltage" v="0.0" help="Electrostatic voltage over lines.">
        </value>
      </condition>
      <condition n="Line_Singularity" pn="Line Singularity" ov="line" ovm="node" icon="drag" help="Number of ungaged layers around a line:\n- In the regularized formulations, the divergence term of the elements\n   inside the ungauged layers is removed.\n- In the LL2P formulations, both the divergence term and the bubble\n   contribution of the elements inside the ungauged layers are removed.">
        <value n="Ungaged_layers" pn="Ungaged layers" v="1" values="1,2,3,4,5,6" help="Number of ungaged layers around a line:\n- In the regularized formulations, the divergence term of the elements\n   inside the ungauged layers is removed.\n- In the LL2P formulations, both the divergence term and the bubble\n   contribution of the elements inside the ungauged layers are removed.">
        </value>
      </condition>
      <condition n="Perfect_Electric_Conductor_(PEC)" pn="Perfect Electric Conductor (PEC)" ov="surface" ovm="element" icon="drag" help="- For E-field formulations, it imposes n x E = 0 on the surface.\n- For A-V potential formulations, it sets n x A = 0 and V = 0 on the surface.\n- For edge-stabilized formulations, it additionally sets the Lagrange multiplier\n   equal to zero on the surface.">
        <value n="n_x_E_=" pn="n x E =" v="0.0" values="0.0" help="- For E-field formulations, it imposes n x E = 0 on the surface.\n- For A-V potential formulations, it sets n x A = 0 and V = 0 on the surface.\n- For edge-stabilized formulations, it additionally sets the Lagrange multiplier\n   equal to zero on the surface.">
        </value>
      </condition>
      <condition n="Perfect_Magnetic_Conductor_(PMC)" pn="Perfect Magnetic Conductor (PMC)" ov="surface" ovm="element" icon="drag" help="- For regularized and LL2P E-field formulations, it imposes n . E = 0 on the surface.\n- For regularized and LL2P A-V potential formulations, it sets n . A = 0 on the surface.\n- It is redundant for double-curl edge formulations.\n- This condition is specifically designed for symmetry surfaces.">
        <value n="n_._E_=" pn="n . E =" v="0.0" values="0.0" help="- For regularized and LL2P E-field formulations, it imposes n . E = 0 on the surface.\n- For regularized and LL2P A-V potential formulations, it sets n . A = 0 on the surface.\n- It is redundant for double-curl edge formulations.\n- This condition is specifically designed for symmetry surfaces.">
        </value>
      </condition>
      <condition n="Transversal_Electric_Condition_(TEC)" pn="Transversal Electric Condition (TEC)" ov="surface" ovm="element" icon="drag" help="- For regularized and LL2P E-field formulations, it imposes n . E = 0 on the surface.\n- For regularized and LL2P A-V potential formulations, it sets n . A = 0 on the surface.\n- It is redundant for double-curl edge formulations.\n- This condition is specifically designed for waveguide port surfaces.">
        <value n="n_._E_=" pn="n . E =" v="0.0" values="0.0" help="- For regularized and LL2P E-field formulations, it imposes n . E = 0 on the surface.\n- For regularized and LL2P A-V potential formulations, it sets n . A = 0 on the surface.\n- It is redundant for double-curl edge formulations.\n- This condition is specifically designed for waveguide port surfaces.">
        </value>
      </condition>
      <condition n="Periodic_Boundary_Condition_(PBC)" pn="Periodic Boundary Condition (PBC)" ov="surface" ovm="element" icon="drag" help="It enforces equal fields (with a phase difference) on two \nseparate surfaces:\n\n- &quot;Front-Back&quot; surfaces must lie parallel to the XY-plane.\n\n- For cyclic periodic symmetry, &quot;Left&quot; surface must be \n   positioned in the 00-YZ plane and the axis of rotation \n   must align with the Z-axis.\n\n- Set the symmetry type and phase difference between \n   surfaces in &quot;Solving parameters&quot; -&gt; &quot;Geometry&quot;.\n\n- If PBCs are required only between parallel surfaces with  \n   no phase difference, separate contact volume elements  \n   can be used as an equivalent alternative.\n ">
        <value n="Face" pn="Face" v="Front" values="Front,Back,Right,Left" help="It enforces equal fields (with a phase difference) on two \nseparate surfaces:\n\n- &quot;Front-Back&quot; surfaces must lie parallel to the XY-plane.\n\n- For cyclic periodic symmetry, &quot;Left&quot; surface must be \n   positioned in the 00-YZ plane and the axis of rotation \n   must align with the Z-axis.\n\n- Set the symmetry type and phase difference between \n   surfaces in &quot;Solving parameters&quot; -&gt; &quot;Geometry&quot;.\n\n- If PBCs are required only between parallel surfaces with  \n   no phase difference, separate contact volume elements  \n   can be used as an equivalent alternative.\n ">
        </value>
      </condition>
      <condition n="Surface_Voltage_Full_wave" pn="Surface Voltage Full wave" ov="surface" ovm="node" icon="drag" help="Time-harmonic voltage module over surfaces.">
        <value n="Module_Voltage" pn="Module Voltage" v="0.0" help="Time-harmonic voltage module over surfaces.">
        </value>
        <value n="Phase_Voltage" pn="Phase Voltage" v="0.0" help="Time-harmonic voltage phase over surfaces.">
        </value>
      </condition>
      <condition n="Surface_Voltage_Electrostatic" pn="Surface Voltage Electrostatic" ov="surface" ovm="node" icon="drag" help="Electrostatic voltage over surfaces.">
        <value n="Voltage" pn="Voltage" v="0.0" help="Electrostatic voltage over surfaces.">
        </value>
      </condition>
      <condition n="Surface_Singularity" pn="Surface Singularity" ov="surface" ovm="node" icon="drag" help="Number of ungaged layers around a surface:\n- In the regularized formulations, the divergence term of the elements\n   inside the ungauged layers is removed.\n- In the LL2P formulations, both the divergence term and the bubble\n   contribution of the elements inside the ungauged layers are removed.">
        <value n="Ungaged_layers" pn="Ungaged layers" v="1" values="1,2,3,4,5,6" help="Number of ungaged layers around a surface:\n- In the regularized formulations, the divergence term of the elements\n   inside the ungauged layers is removed.\n- In the LL2P formulations, both the divergence term and the bubble\n   contribution of the elements inside the ungauged layers are removed.">
        </value>
      </condition>
    </container>
    <container n="Robin_conditions" pn="Robin conditions">
      <condition n="Far_field_condition_Full_wave" pn="Far field condition Full wave" ov="surface" ovm="element" icon="drag" help="Far field boundary condition (1st order ABC).">
        <value n="Far_field" pn="Far field" v="1st_ABC" values="1st_ABC" help="Far field boundary condition (1st order ABC).">
        </value>
      </condition>
      <condition n="Far_field_condition_Cold_plasma" pn="Far field condition Cold plasma" ov="surface" ovm="element" icon="drag" help="Cold plasma wave type at the boundary:\n- FW : n2 = RL/S.\n- RW : n2 = R.\n- LW : n2 = L.\n- PW : n2 = P.">
        <value n="Plasma_wave_type" pn="Plasma wave type" v="FW" values="FW,RW,LW,PW" help="Cold plasma wave type at the boundary:\n- FW : n2 = RL/S.\n- RW : n2 = R.\n- LW : n2 = L.\n- PW : n2 = P.">
        </value>
      </condition>
      <condition n="Robin_condition_Full_wave" pn="Robin condition Full wave" ov="surface" ovm="element" icon="drag" help="Full wave Robin boundary condition.">
        <value n="Robin_coefficients" pn="Robin coefficients" v="Robin_coeffs_Full_wave" values="Robin_coeffs_Full_wave,Robin_coefficients_Plane_waves,Robin_coefficients_Gauss_beam,Robin_coefficients_Quasiestatic,Robin_coefficients_Electrostatic" help="Full wave Robin boundary condition.">
        </value>
      </condition>
      <condition n="Robin_condition_Imported" pn="Robin condition Imported" ov="surface" ovm="element" icon="drag" help="Robin boundary condition imported from files.">
        <value n="Imported_Robin_surface" pn="Imported Robin surface" v="IRBCS_1" values="IRBCS_1,IRBCS_2,IRBCS_3,IRBCS_4,IRBCS_5,IRBCS_6,IRBCS_7,IRBCS_8,IRBCS_9" help="Robin boundary condition imported from files.">
        </value>
      </condition>
      <condition n="Robin_condition_Electrostatic" pn="Robin condition Electrostatic" ov="surface" ovm="element" icon="drag" help="Far-field boundary conditions for electrostatic problems and current flux input.">
        <value n="Robin_coefficients" pn="Robin coefficients" v="Robin_coeffs_Electrostatic" values="Robin_coeffs_Electrostatic,Robin_coefficients_Plane_waves,Robin_coefficients_Gauss_beam,Robin_coefficients_Quasiestatic,Robin_coefficients_Electrostatic" help="Far-field boundary conditions for electrostatic problems and current flux input.">
        </value>
      </condition>
      <condition n="Coaxial_TEM_condition" pn="Coaxial TEM condition" ov="surface" ovm="element" icon="drag" help="Coaxial waveguide port condition (TEM mode).">
        <value n="Coaxial_Port" pn="Coaxial Port" v="CoaxialPort_1" values="CoaxialPort_1,CoaxialPort_2" help="Coaxial waveguide port condition (TEM mode).">
        </value>
      </condition>
      <condition n="RW_port_TE10_condition" pn="RW port TE10 condition" ov="surface" ovm="element" icon="drag" help="Rectangular waveguide port condition (TE10 mode).">
        <value n="RW_Port" pn="RW Port" v="RWPort_1" values="RWPort_1,RWPort_2" help="Rectangular waveguide port condition (TE10 mode).">
        </value>
      </condition>
    </container>
    <container n="Field_integrals" pn="Field integrals">
      <condition n="Field_surface_integral" pn="Field surface integral" ov="surface" ovm="element" icon="drag" help="Surface over which the fields are integrated.">
        <value n="Surface_to_integer" pn="Surface to integer" v="Surface_1" values="Surface_1,Surface_2,Surface_3,Surface_4,Surface_5,Surface_6,Surface_7,Surface_8,Surface_9" help="Surface over which the fields are integrated.">
        </value>
      </condition>
      <condition n="Projection_RWTE10" pn="Projection RWTE10" ov="surface" ovm="element" icon="drag" help="Rectangular waveguide port over which the scattering parameters Sij are calculated. ">
        <value n="RWPort" pn="RWPort" v="RWPort_1" values="RWPort_1,RWPort_2" help="Rectangular waveguide port over which the scattering parameters Sij are calculated. ">
        </value>
      </condition>
      <condition n="Projection_CoaxialTEM" pn="Projection CoaxialTEM" ov="surface" ovm="element" icon="drag" help="Coaxial waveguide port over which the scattering parameters Sij are calculated.">
        <value n="CoaxialPort" pn="CoaxialPort" v="CoaxialPort_1" values="CoaxialPort_1,CoaxialPort_2" help="Coaxial waveguide port over which the scattering parameters Sij are calculated.">
        </value>
      </condition>
      <condition n="Field_volume_integral" pn="Field volume integral" ov="volume" ovm="element" icon="drag" help="Volume over which the fields are integrated.">
        <value n="Volume_to_integer" pn="Volume to integer" v="Volume_1" values="Volume_1,Volume_2,Volume_3,Volume_4,Volume_5,Volume_6,Volume_7,Volume_8,Volume_9" help="Volume over which the fields are integrated.">
        </value>
      </condition>
    </container>
    <container n="Current_sources" pn="Current sources">
      <condition n="FD_current_density" pn="FD current density" ov="volume" ovm="element" icon="drag" help="Value of the current density over a volume.">
        <value n="Source" pn="Source" v="J_source" values="J_source,J_cartesian,J_axisymm,J_combine,J_helicoidal,J_plasmam" help="Value of the current density over a volume.">
        </value>
      </condition>
    </container>
  </container>

  <container n="Results" pn="Results">
    <container n="Frequency_domain" pn="Frequency domain">
      <value n="E" pn="E" v="1" values="0,1" help="Time-harmonic electric field.">
      </value>
      <value n="H" pn="H" v="1" values="0,1" help="Time-harmonic magnetic field.">
      </value>
      <value n="B" pn="B" v="1" values="0,1" help="Time-harmonic magnetic flux density.">
      </value>
      <value n="J" pn="J" v="1" values="0,1" help="Time-harmonic total current density: Jtotal = Jimposed + sigma * E.">
      </value>
      <value n="Poynting_vector" pn="Poynting vector" v="0" values="0,1" help="Time averaged Poynting vector: &lt; S &gt; = 0.5 * Real( E x conj( H ) ).">
      </value>
      <value n="Joule_heating" pn="Joule heating" v="0" values="0,1" help="Time averaged Joule heating for IHL materials: &lt; Q &gt; = 0.5 * ( sigma + w * Imag( eps ) ) * | E |^2.">
      </value>
      <value n="Lorentz_force" pn="Lorentz force" v="0" values="0,1" help="Time averaged Lorentz force: &lt; F &gt; = 0.5 * Real( J x conj( B ) ).">
      </value>
    </container>
    <container n="Time_domain" pn="Time domain">
      <value n="Initial_time" pn="Initial time" v="Time step" help="Initial time for time domain animations.">
      </value>
      <value n="Final_time" pn="Final time" v="T" help="Final time for time domain animations.">
      </value>
      <value n="Time_step" pn="Time step" v="T/32" help="Time step for time domain animations.">
      </value>
      <value n="E(t)" pn="E(t)" v="0" values="0,1" help="Time-harmonic electric field in time domain.">
      </value>
      <value n="H(t)" pn="H(t)" v="0" values="0,1" help="Time-harmonic magnetic field in time domain.">
      </value>
      <value n="B(t)" pn="B(t)" v="0" values="0,1" help="Time-harmonic magnetic flux density in time domain.">
      </value>
      <value n="J(t)" pn="J(t)" v="0" values="0,1" help="Time-harmonic total current density in time domain.">
      </value>
    </container>
    <container n="Cold_plasma" pn="Cold plasma">
      <value n="Electron_density" pn="Electron density" v="1" values="0,1" help="Electron density profile. ">
      </value>
      <value n="External_B_field" pn="External B field" v="1" values="0,1" help="External B field.">
      </value>
      <value n="Permittivity_tensor" pn="Permittivity tensor" v="0" values="0,1" help="Real part of the cold plasma permittivity tensor components (S, P, D, R, and L).">
      </value>
      <value n="E_perpendicular" pn="E perpendicular" v="0" values="0,1" help="Projection of the time-harmonic electric field on the direction perpendicular to the applied B field.">
      </value>
      <value n="E_parallel" pn="E parallel" v="0" values="0,1" help="Projection of the time-harmonic electric field on the direction parallel to the applied B field.">
      </value>
      <value n="E_perpendicular_(t)" pn="E perpendicular (t)" v="0" values="0,1" help="Perpendicular electric field in time domain.">
      </value>
      <value n="E_parallel_(t)" pn="E parallel (t)" v="0" values="0,1" help="Parallel electric field in time domain.">
      </value>
    </container>
    <container n="Electrostatic" pn="Electrostatic">
      <value n="Electrostaic_potential" pn="Electrostaic potential" v="1" values="0,1" help="Electrostatic electric potential in Volts. ">
      </value>
      <value n="Electrostatic_E_field" pn="Electrostatic E field" v="1" values="0,1" help="Electrostatic electric field ( E = -grad(V) ).">
      </value>
      <value n="Electrostatic_current_density" pn="Electrostatic current density" v="1" values="0,1" help="Electrostatic current density ( J = sigma * E ).">
      </value>
      <value n="Electrostatic_Joule_heating" pn="Electrostatic Joule heating" v="1" values="0,1" help="Electrostatic Joule heating ( Q = sigma * | E |^2 ).">
      </value>
      <value n="Export_electrostatic_currents" pn="Export electrostatic currents" v="0" values="0,1" help="Writes the electrostatic current density to the file &quot;Jsource-(Export_Id).dat&quot;.">
      </value>
      <value n="Export__Id" pn="Export Id" v="1" help="Current source export file Id.">
      </value>
      <value n="Export_Ph" pn="Export Ph" v="0" help="The exported current density will be multiplied by exp(i*Export_Ph) when imported.">
      </value>
    </container>
  </container>

</ermes_data>
